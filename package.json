{
  "name": "chatdock",
  "version": "1.3.1",
  "description": "ChatGPT 与 Claude：桌面端和浏览器侧边栏",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "dev:desktop": "electron .",
    "postinstall": "node scripts/patch-deps.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "check": "node scripts/build-extension.mjs && node scripts/check.mjs",
    "test": "node scripts/build-extension.mjs && node tests/test_template.mjs && node tests/test_page_info.mjs && node tests/test_delivery.mjs && node extension/tools/test_bridge.mjs && node --test tests/providers.test.cjs tests/desktop.test.cjs tests/sidepanel.test.cjs tests/claude-frame-compat.test.cjs",
    "icons:tray": "node scripts/make-tray-icon.mjs --preview",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "release:gh": "node scripts/publish.mjs",
    "test:desktop": "electron tests/smoke-desktop.cjs"
  },
  "build": {
    "appId": "com.zhoudaxiaa.chatgpt-electron",
    "productName": "ChatDock",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "shared/**",
      "!desktop/LEGACY_README.md"
    ],
    "asarUnpack": [
      "node_modules/node-screenshots*/**"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "desktop/icon.png",
      "identity": null
    },
    "win": {
      "target": [
        "nsis",
        "portable",
        "zip"
      ],
      "icon": "desktop/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "npmRebuild": true
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "26.18.0",
    "electron-builder-squirrel-windows": "26.18.0"
  },
  "dependencies": {
    "electron-screenshots": "^0.6.2"
  },
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
